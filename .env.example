# Postgres (Neon) connection string used by Prisma.
# Prefer the pooled host (*-pooler.*) and include pgbouncer + a small connection_limit.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connection_limit=3&pool_timeout=30&connect_timeout=30
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=3&pool_timeout=30&connect_timeout=30"

# Secret used to sign session cookies. Use a long random value (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-secret"

# Directory where task attachments are stored (relative to the project root).
UPLOAD_DIR="storage/uploads"

# Login brute-force limiter (in-memory). Defaults ON in production, OFF in development.
# Set to 1/true to force on, or 0/false to force off.
# LOGIN_RATE_LIMIT=1

# Optional: after syncing employees, copy Kelin Connect password hashes into this app's DBs
# (Neon + db_rd_management only; source DB is read-only):
#   node scripts/sync-passwords-from-kelinconnect.mjs
