generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CommentKind {
  COMMENT
  PROGRESS_UPDATE
}

enum ActivityAction {
  TASK_CREATED
  TASK_UPDATED
  ASSIGNEE_CHANGED
  TASK_CLAIMED
  RETURNED_TO_OPEN
  STATUS_CHANGED
  PROGRESS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_ARCHIVED
  TASK_UNARCHIVED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  TIME_LOGGED
  USER_CREATED
  USER_UPDATED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_PASSWORD_RESET
  PROFILE_UPDATED
  PASSWORD_CHANGED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_UNASSIGNED
  TASK_CLAIMED
  DUE_DATE_CHANGED
  COMMENT_ADDED
  MENTIONED
  TASK_SUBMITTED_FOR_REVIEW
  TASK_COMPLETED
  TASK_RETURNED_TO_OPEN
  TASK_REOPENED
}

model User {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(120)
  email          String    @unique @db.VarChar(191)
  passwordHash   String    @db.VarChar(255)
  role           Role      @default(EMPLOYEE)
  isActive       Boolean   @default(true)
  jobTitle       String?   @db.VarChar(120)
  department     String?   @db.VarChar(120)
  phone          String?   @db.VarChar(40)
  bio            String?   @db.Text
  avatarColor    String?   @db.VarChar(20)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  comments        Comment[]
  activities      ActivityLog[]  @relation("ActivityActor")
  subjectActivity ActivityLog[]  @relation("ActivitySubjectUser")
  notifications   Notification[]
  attachments     Attachment[]

  @@index([role, isActive])
}

model Task {
  id               String     @id @default(cuid())
  taskKey          String     @unique @db.VarChar(20)
  title            String     @db.VarChar(200)
  description      String?    @db.Text
  status           TaskStatus @default(NOT_STARTED)
  priority         Priority   @default(NORMAL)
  progress         Int        @default(0)
  assigneeId       String?
  createdById      String
  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?
  claimedAt        DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  isArchived       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tags          Tag[]
  comments      Comment[]
  activities    ActivityLog[]
  notifications Notification[]
  attachments   Attachment[]

  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([priority])
  @@index([isArchived])
  @@index([completedAt])
  @@index([isArchived, assigneeId, status])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Comment {
  id        String      @id @default(cuid())
  taskId    String
  authorId  String
  kind      CommentKind @default(COMMENT)
  body      String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model ActivityLog {
  id            String         @id @default(cuid())
  taskId        String?
  actorId       String
  subjectUserId String?
  action        ActivityAction
  oldValue      Json?
  newValue      Json?
  createdAt     DateTime       @default(now())

  task        Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User  @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  subjectUser User? @relation("ActivitySubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([actorId])
  @@index([createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  taskId      String?
  type        NotificationType
  message     String           @db.VarChar(500)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  task      Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  fileName     String   @db.VarChar(255)
  storageKey   String   @unique @db.VarChar(255)
  mimeType     String   @db.VarChar(120)
  sizeBytes    Int
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
}

/// Monotonic counters used for concurrency-safe key generation (e.g. task keys).
model Sequence {
  name  String @id @db.VarChar(50)
  value Int    @default(0)
}
